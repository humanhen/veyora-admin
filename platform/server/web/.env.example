# Veyora public website — example environment file.
# Copy a line from here, never a secret. No real Veyora domain belongs here —
# the canonical domain and portal destination are undecided
# (DECISION-01 / DECISION-02 in docs/public-website-rebuild/08_RISKS_AND_OPEN_DECISIONS.md).

# Required in production. In development, both fall back to documented
# localhost defaults when unset — see src/env.ts. In production, a missing
# or malformed value throws at startup rather than serving with broken URLs.
#   Development defaults: PUBLIC_SITE_ORIGIN=http://localhost:4321
#                          PORTAL_ORIGIN=http://localhost:4322
PUBLIC_SITE_ORIGIN=
PORTAL_ORIGIN=

NODE_ENV=development
