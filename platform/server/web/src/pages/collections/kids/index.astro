---
// Route 8 of 25 — 05_ROUTE_TEMPLATE_MATRIX.md. API-backed as of B2.3.
// Metadata/H1 come from the central registry, still marked pendingContent
// there (the specification leaves these category titles/H1s "*derive —
// must be unique*"). The category filter is INJECTED into the shared
// loader rather than this route duplicating any fetching logic.
import Page from '../../../layouts/Page.astro';
import CatalogueListing from '../../../components/public/CatalogueListing.astro';
import { STATIC_ROUTE_METADATA } from '../../../lib/metadata.ts';
import { staticBreadcrumbs } from '../../../lib/routes.ts';
import { loadCataloguePage } from '../../../lib/catalogue-page.ts';

const basePath = '/collections/kids/';
const state = await loadCataloguePage(Astro.url, { basePath, forcedCategory: 'Kids' });
Astro.response.status = state.status;
---

<Page meta={STATIC_ROUTE_METADATA['/collections/kids/']} breadcrumbs={staticBreadcrumbs('/collections/kids/')}>
  <CatalogueListing state={state} basePath={basePath} subject="kids models" />
</Page>
