---
// Route 9 of 25 — 05_ROUTE_TEMPLATE_MATRIX.md: `/collections/{brand}/{model}/`.
// No catalogue data source exists until B2/B4, so this renders the same
// neutral skeleton for any brand/model slug pair. Real publication lookups
// and unknown-slug 404 behaviour are deferred to B2/B4.
import Page from '../../../../layouts/Page.astro';
import SkeletonNotice from '../../../../components/dev/SkeletonNotice.astro';
import { breadcrumbsWithHome, humanizeSlug } from '../../../../lib/routes.ts';

const { brand, model } = Astro.params;
const brandLabel = humanizeSlug(brand ?? '');
const modelLabel = humanizeSlug(model ?? '');
---

<Page
  title="Model detail page | Veyora"
  breadcrumbs={breadcrumbsWithHome([
    { label: 'Collections', href: '/collections/' },
    { label: `${brandLabel} ${modelLabel}`, href: `/collections/${brand}/${model}/` },
  ])}
>
  <h1>Model detail page</h1>
  <SkeletonNotice note={`Showing the temporary skeleton for brand: ${brand}, model: ${model}`} />
</Page>
