---
// Routes 14 AND 15 of 25 — 05_ROUTE_TEMPLATE_MATRIX.md lists
// `/resources/{category}/` (ResourceCategory) and `/resources/{slug}/`
// (Article) as separate templates at the SAME single-segment path depth.
// Astro's file router cannot host two different dynamic routes at an
// identical pattern (`[category]` and `[slug]` would collide), and no
// content source exists yet to disambiguate a category slug from an
// article slug at request time. One shared file stands in for both until
// Astro Content Collections (B5) make that distinction possible.
import Page from '../../../layouts/Page.astro';
import SkeletonNotice from '../../../components/dev/SkeletonNotice.astro';
import { resourceMetadata } from '../../../lib/metadata.ts';
import { breadcrumbsWithHome, humanizeSlug } from '../../../lib/routes.ts';

const { slug } = Astro.params;
const meta = resourceMetadata(slug ?? '');
const slugLabel = humanizeSlug(slug ?? '');
---

<Page
  meta={meta}
  breadcrumbs={breadcrumbsWithHome([
    { label: 'Resources', href: '/resources/' },
    { label: slugLabel, href: `/resources/${slug}/` },
  ])}
>
  <SkeletonNotice
    note={`Showing the temporary skeleton for slug: ${slug}. Category-vs-article disambiguation is deferred to B5.`}
  />
</Page>
