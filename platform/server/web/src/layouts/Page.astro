---
import Base from './Base.astro';
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';
import Breadcrumbs from '../components/nav/Breadcrumbs.astro';
import MobileMenu from '../components/nav/MobileMenu.astro';
import { buildSeoHead } from '../lib/seo.ts';
import { buildWebSite, buildBreadcrumbs, serialiseJsonLd, type JsonLd } from '../lib/structured-data.ts';
import { env } from '../env.ts';
import type { RouteMetadata } from '../lib/metadata.ts';
import type { BreadcrumbItem } from '../lib/routes.ts';

interface Props {
  /** The route's central metadata record (src/lib/metadata.ts) — the H1
   * below and every <head> tag Base.astro renders both come from this one
   * object, so they cannot drift apart. */
  meta: RouteMetadata;
  /** Omit entirely for the home route, which carries no breadcrumb trail. */
  breadcrumbs?: BreadcrumbItem[];
  /** Set only by the 404/500 pages — see src/lib/seo.ts. */
  fixedRobots?: string;
  /* Page-specific JSON-LD (Fast-Track Phase 4). WebSite and BreadcrumbList
     are added here for every page; a route passes only what is specific to
     it — a Product, a Brand, a CollectionPage. */
  jsonLd?: JsonLd | JsonLd[];
}

const { meta, breadcrumbs, fixedRobots, jsonLd } = Astro.props;
const currentPath = Astro.url.pathname;
const seo = buildSeoHead({
  meta,
  pathname: Astro.url.pathname,
  searchParams: Astro.url.searchParams,
  fixedRobots,
});

/* Structured data is suppressed on any page the site tells crawlers not to
   index. Describing a noindex page in JSON-LD is a contradiction: it asks a
   crawler to both ignore the page and treat its claims as authoritative. */
const indexable = !seo.robots.startsWith('noindex');
const breadcrumbNode = breadcrumbs ? buildBreadcrumbs(breadcrumbs, env.siteOrigin) : null;
const structuredData: JsonLd[] = indexable
  ? [buildWebSite(env.siteOrigin), breadcrumbNode, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])]
      .filter((node): node is JsonLd => node !== null)
  : [];
---

<Base seo={seo}>
  <!--
    #site is the inert target while the mobile menu is open (see
    MobileMenu.astro's script) — everything a visitor could otherwise tab
    into or click behind the open panel lives inside it. The panel itself
    is deliberately rendered as a sibling, outside #site, so making #site
    inert never hides the menu that is currently open.
  -->
  <div id="site">
    <Header currentPath={currentPath} />
    {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
    <main id="main-content">
      <h1>{meta.h1}</h1>
      <slot />
    </main>
    <Footer />
  </div>
  <MobileMenu currentPath={currentPath} />

  {
    structuredData.map((node) => (
      <script
        slot="structured-data"
        type="application/ld+json"
        is:inline
        set:html={serialiseJsonLd(node)}
      />
    ))
  }
</Base>
