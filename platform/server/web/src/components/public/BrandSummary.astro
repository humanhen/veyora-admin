---
/* One published brand, as an entry in the brand index (B2.3).

   Same editorial reasoning as ModelCard: hairline-ruled article, no boxed
   or rounded panel, no shadow. Renders only what the API supplies and
   omits every absent optional field rather than printing a placeholder —
   a brand with no approved headline simply shows its name. */
import type { PublicBrandSummary } from '../../lib/public-types.ts';
import PublicImage from './PublicImage.astro';

interface Props {
  brand: PublicBrandSummary;
  headingLevel?: 2 | 3;
}

const { brand, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = `/brands/${brand.slug}/`;
---

<article class="brand-summary">
  <a class="brand-summary__link" href={href}>
    {
      brand.logoMedia && (
        <span class="brand-summary__logo">
          <PublicImage media={brand.logoMedia} fallbackAlt={`${brand.name} logo`} />
        </span>
      )
    }
    <Heading class="brand-summary__name">{brand.name}</Heading>
  </a>
  {brand.segment && <p class="brand-summary__segment">{brand.segment}</p>}
  {brand.headline && <p class="brand-summary__headline">{brand.headline}</p>}
  {brand.priceTierLabel && <p class="brand-summary__tier">{brand.priceTierLabel}</p>}
</article>

<style>
  .brand-summary {
    display: flex;
    flex-direction: column;
    padding-top: clamp(16px, 2.2vw, 22px);
    border-top: 1px solid var(--rule);
  }
  .brand-summary__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .brand-summary__logo {
    display: block;
    max-width: 180px;
    margin-bottom: clamp(12px, 1.6vw, 16px);
  }
  .brand-summary__name {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--display-xs);
    font-weight: 400;
    line-height: 1.2;
    color: var(--ink);
  }
  .brand-summary__link:hover .brand-summary__name {
    box-shadow: inset 0 -1px 0 var(--ink);
  }
  .brand-summary__segment,
  .brand-summary__tier {
    margin: 8px 0 0;
    font-family: var(--sans);
    font-size: var(--eyebrow);
    font-weight: 600;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .brand-summary__headline {
    margin: 10px 0 0;
    max-width: 44ch;
    font-size: var(--body);
    line-height: 1.8;
    color: var(--ink-soft);
  }
</style>
