---
/* Presentational body for a catalogue listing (B2.3).

   Deliberately does NO fetching and sets NO status — both live in the page
   frontmatter via loadCataloguePage() (src/lib/catalogue-page.ts), because
   `Astro.response.status` set from inside a nested component has no effect
   on the response. This component only renders the state it is handed. */
import ModelGrid from './ModelGrid.astro';
import Pagination from './Pagination.astro';
import EmptyPublishedContent from './EmptyPublishedContent.astro';
import PublicDataUnavailable from './PublicDataUnavailable.astro';
import type { CataloguePageState } from '../../lib/catalogue-page.ts';

interface Props {
  state: CataloguePageState;
  basePath: string;
  /** What this listing shows, for the empty-state wording. */
  subject?: string;
}

const { state, basePath, subject = 'models' } = Astro.props;
const { result, queryError, page, hasMore, previousHref, nextHref } = state;
const models = result?.ok ? result.data.items : [];
const isBadRequest = queryError !== null || (result !== null && !result.ok && result.kind === 'bad-request');
const isUnavailable = result !== null && !result.ok && result.kind !== 'bad-request';
---

{
  isBadRequest && (
    <div class="catalogue-error">
      <p class="catalogue-error__body">
        That request was not valid. Please check the link and try again, or browse{' '}
        <a href={basePath}>all {subject}</a>.
      </p>
    </div>
  )
}

{isUnavailable && <PublicDataUnavailable subject={subject} />}

{result?.ok && models.length === 0 && <EmptyPublishedContent subject={subject} />}

{
  result?.ok && models.length > 0 && (
    <>
      <ModelGrid models={models} />
      <Pagination page={page} hasMore={hasMore} previousHref={previousHref} nextHref={nextHref} />
    </>
  )
}

<style>
  .catalogue-error {
    max-width: 46ch;
    margin: clamp(28px, 5vw, 48px) 0;
    padding: clamp(16px, 2.4vw, 22px) clamp(18px, 2.6vw, 24px);
    border: 1px solid var(--rule);
    border-left: 2px solid var(--ink);
  }
  .catalogue-error__body {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .catalogue-error__body a {
    color: var(--ink);
  }
</style>
