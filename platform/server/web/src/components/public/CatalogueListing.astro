---
/* Presentational body for a catalogue listing (B2.3).

   Deliberately does NO fetching and sets NO status — both live in the page
   frontmatter via loadCataloguePage() (src/lib/catalogue-page.ts), because
   `Astro.response.status` set from inside a nested component has no effect
   on the response. This component only renders the state it is handed. */
import ModelGrid from './ModelGrid.astro';
import Pagination from './Pagination.astro';
import EmptyPublishedContent from './EmptyPublishedContent.astro';
import PublicDataUnavailable from './PublicDataUnavailable.astro';
import CatalogueFilters from './CatalogueFilters.astro';
import type { CataloguePageState } from '../../lib/catalogue-page.ts';

interface Props {
  state: CataloguePageState;
  basePath: string;
  /** What this listing shows, for the empty-state wording. */
  subject?: string;
}

const { state, basePath, subject = 'models' } = Astro.props;
const { result, queryError, page, hasMore, previousHref, nextHref, filters, formAction, facetsUnavailable } = state;
const models = result?.ok ? result.data.items : [];
const isBadRequest = queryError !== null || (result !== null && !result.ok && result.kind === 'bad-request');
const isUnavailable = result !== null && !result.ok && result.kind !== 'bad-request';

/* An empty result means two different things, and conflating them is how a
   filtered search reads as "we publish nothing". `filtersApplied` is what
   separates them; an upstream failure is neither and is handled above. */
const filtersApplied = (filters?.active.length ?? 0) > 0;
const isEmptyWithFilters = result?.ok === true && models.length === 0 && filtersApplied;
const isEmptyCatalogue = result?.ok === true && models.length === 0 && !filtersApplied;

/* Controls are shown whenever the request itself was valid — including when
   a filtered search returned nothing, because that is precisely when a
   visitor needs to change or clear a filter. They are hidden only for an
   invalid query or an upstream failure, where the form would be offering
   choices against state we could not read. */
const showFilters = filters !== null && !isBadRequest && !isUnavailable;
---

{
  isBadRequest && (
    <div class="catalogue-error">
      <p class="catalogue-error__body">
        That request was not valid. Please check the link and try again, or browse{' '}
        <a href={basePath}>all {subject}</a>.
      </p>
    </div>
  )
}

{isUnavailable && <PublicDataUnavailable subject={subject} />}

{
  showFilters && (
    <CatalogueFilters filters={filters!} formAction={formAction} facetsUnavailable={facetsUnavailable} />
  )
}

{isEmptyCatalogue && <EmptyPublishedContent subject={subject} />}

{
  isEmptyWithFilters && (
    <div class="catalogue-empty-filtered">
      <p class="catalogue-empty-filtered__body">
        No {subject} match the filters you have selected.
      </p>
      <p class="catalogue-empty-filtered__body">
        <a href={filters!.clearAllHref ?? basePath}>Clear all filters</a> to see the full range.
      </p>
    </div>
  )
}

{
  result?.ok && models.length > 0 && (
    <>
      <ModelGrid models={models} />
      <Pagination page={page} hasMore={hasMore} previousHref={previousHref} nextHref={nextHref} />
    </>
  )
}

<style>
  .catalogue-empty-filtered {
    max-width: 46ch;
    margin: clamp(28px, 5vw, 48px) 0;
    padding: clamp(16px, 2.4vw, 22px) clamp(18px, 2.6vw, 24px);
    border: 1px solid var(--rule);
    border-left: 2px solid var(--ink);
  }
  .catalogue-empty-filtered__body { margin: 0 0 8px; }
  .catalogue-empty-filtered__body:last-child { margin-bottom: 0; }

  .catalogue-error {
    max-width: 46ch;
    margin: clamp(28px, 5vw, 48px) 0;
    padding: clamp(16px, 2.4vw, 22px) clamp(18px, 2.6vw, 24px);
    border: 1px solid var(--rule);
    border-left: 2px solid var(--ink);
  }
  .catalogue-error__body {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .catalogue-error__body a {
    color: var(--ink);
  }
</style>
