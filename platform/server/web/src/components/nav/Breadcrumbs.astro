---
/* Renders the same {label, href} trail that will feed BreadcrumbList
   JSON-LD in a later batch (B1.3/B7) — see src/lib/routes.ts. The visible
   trail and that structured data are built from one array so they cannot
   drift apart. */
import type { BreadcrumbItem } from '../../lib/routes.ts';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li>
            {isLast ? (
              <span aria-current="page">{item.label}</span>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(14px, 2vw, 20px) var(--gutter) 0;
  }
  .breadcrumbs ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 0;
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
    font-family: var(--sans);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
  }
  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin: 0 8px;
    color: var(--ink-faint);
  }
  .breadcrumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--ink);
  }
  .breadcrumbs span[aria-current='page'] {
    color: var(--ink);
  }
</style>
