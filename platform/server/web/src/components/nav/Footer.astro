---
/* Extends the storefront's dark editorial `.hm-foot` language (near-black
   background, hairline top border, white-on-dark link scale) as a fresh
   component — no portal/storefront source imported or copied. Reference
   only: platform/server/storefront/css/store.css `.hm-foot*` (read, not
   touched). Four link groups plus a legal row, per
   docs/public-website-rebuild/02_VISUAL_SYSTEM_INVENTORY.md §5.4 (the
   specification's own extension of the current two-column footer).

   No social links: the current storefront's social-footer work belongs to
   the other developer's branch and is out of scope here (see B1.2 task
   brief). Approved social profiles, if any, are content/configuration for
   a later batch — this component has no social markup to accidentally
   duplicate or fight with. */
import { footerGroups } from '../../lib/nav.ts';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-surface="dark">
  <div class="site-footer__inner">
    <a class="site-footer__logo" href="/" aria-label="Veyora — home">
      <img src="/logo-white.svg" width="142" height="19" alt="" />
    </a>

    <div class="site-footer__groups">
      {
        footerGroups.map((group) => (
          <div class="site-footer__group">
            <p class="site-footer__group-heading">{group.heading}</p>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="site-footer__legal">© {year} Veyora. All rights reserved.</div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--void);
    color: #fff;
    border-top: 1px solid var(--rule-dark);
  }

  .site-footer__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(34px, 3.6vw, 48px) clamp(20px, 4vw, 40px) calc(52px + env(safe-area-inset-bottom, 0px));
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 28px clamp(24px, 4vw, 48px);
    align-items: start;
  }

  .site-footer__logo {
    grid-column: 1;
    justify-self: start;
  }
  .site-footer__logo img {
    display: block;
    width: auto;
    height: 19px;
  }

  .site-footer__groups {
    grid-column: 2;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px clamp(20px, 3vw, 40px);
  }

  .site-footer__group-heading {
    margin: 0 0 12px;
    font-family: var(--sans);
    font-size: var(--eyebrow);
    font-weight: 600;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    color: var(--on-dark-faint);
  }
  .site-footer__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .site-footer__group a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--on-dark-soft);
    font-size: 12.5px;
    text-decoration: none;
  }
  .site-footer__group a:hover {
    color: #fff;
  }

  .site-footer__legal {
    grid-column: 1 / -1;
    padding-top: 20px;
    border-top: 1px solid var(--rule-dark);
    font-size: 12px;
    color: var(--on-dark-faint);
  }

  @media (max-width: 820px) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .site-footer__logo,
    .site-footer__groups,
    .site-footer__legal {
      grid-column: 1;
    }
    .site-footer__groups {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
