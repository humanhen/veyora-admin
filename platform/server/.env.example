# Veyora platform — example environment file.
#
# The real file lives on the server at /opt/veyora/.env and is NOT in git.
#
# IMPORTANT: deploy.sh only creates .env on the very first run ("generating
# .env (first run only)") and keeps it untouched afterwards. Adding a variable
# here does NOT put it on the server — /opt/veyora/.env must be edited by hand,
# then `docker compose up -d api` to pick the change up.
#
# Copy a line from here, never a secret. No real credentials or real addresses
# belong in this file.

# ---------- core (generated by deploy.sh on first run) ----------
DB_PASSWORD=change-me
JWT_SECRET=change-me
DOMAIN=veyora.design
# DEPRECATED — see the origin contract below. Still read as a fallback for
# PORTAL_ORIGIN so an existing deployment keeps working, and it logs a
# deprecation notice when used. It no longer affects cookie security at all.
PUBLIC_URL=https://veyora.design

# ---------- origin and session-cookie contract (Security Hardening Phase 1) ----------
# PUBLIC_URL used to mean two things at once: where portal links point, AND
# whether the session cookie carried `Secure`. That is fine until the public-site
# cutover, at which point PUBLIC_URL naturally becomes the PUBLIC site — and
# repointing it silently downgraded the authentication cookies with no error
# (finding AUTH-002). These variables split the two apart.
#
# Where the B2B portal lives. Every password-reset, order, backorder and
# shared-list link points here. Set it explicitly before the cutover.
# PORTAL_ORIGIN=https://portal.example.test
#
# Where the admin panel lives. Defaults to <PORTAL_ORIGIN>/admin, which is the
# current topology. Set it only if the admin panel moves to its own host.
# ADMIN_ORIGIN=https://portal.example.test/admin
#
# Session-cookie security. Unset = secure in production, insecure elsewhere.
# Setting it false in production is refused unless
# ALLOW_INSECURE_COOKIES=i-accept-plaintext-sessions is also set.
# COOKIE_SECURE=true
#
# How many reverse proxies sit in front of the API. One (Caddy) here.
# This must match reality: each hop is one more X-Forwarded-For entry a client
# could forge to choose its own apparent IP and defeat rate limiting.
TRUST_PROXY_HOPS=1

# ---------- transactional email (Gmail / Google Workspace app password) ----------
# The live sender identity is recorded in docs/RUNBOOK.md, not here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- ordering behaviour ----------
# Whether customers may order more than is currently in stock. The shortfall is
# split off automatically into a backorder record.
#   true  (default, and the documented Monday-release value)
#         - out-of-stock frames can be added to the cart
#         - quantities may exceed availability
#         - available qty becomes the order, the rest becomes a backorder
#         - an entirely unavailable purchase becomes a full backorder
#   false - ordering is restricted to stock on hand in both the API and the
#           storefront; a stock conflict is rejected atomically and the cart is
#           preserved so the customer can adjust it.
# Unset or unrecognised values fall back to true.
ALLOW_CUSTOMER_BACKORDERS=true

# Staff who receive an alert when an order or backorder is created.
# Comma-separated; entries are trimmed and blanks ignored. Leave empty to switch
# the alert off entirely — nothing is sent and nothing fails.
# NOTE: the example address below is a PLACEHOLDER and is deliberately ignored
# at runtime. Replace it with real recipients before the alert will send.
ORDER_ALERT_EMAILS=orders@example.com

# Staff who are told a public-website enquiry arrived (Final Handover Phase 1,
# findings ENQ-006 / NOT-006 — before this, an enquiry was stored and nobody
# was ever told). Same comma-separated format and same placeholder filtering.
#
# Unset, this FALLS BACK to ORDER_ALERT_EMAILS, so an existing deployment
# starts getting enquiry alerts without editing /opt/veyora/.env. Set it only
# when sales enquiries should reach a different inbox from fulfilment alerts.
#
# Empty (and an empty ORDER_ALERT_EMAILS) means no alert is queued at all. That
# is not a silent failure: the enquiry is still stored, and the Enquiries
# screen shows the alert as "Not configured" against the submission.
# ENQUIRY_ALERT_EMAILS=enquiries@example.com

# ---------- notification delivery worker (Final Handover Phase 1) ----------
# Alerts are written to the notification_outbox table in the SAME transaction
# as the thing that caused them, then delivered by a background worker with
# bounded retries. A notification is only ever marked delivered against a
# provider reference — no adapter reports success without one.
#
# With SMTP_HOST/SMTP_USER/SMTP_PASS unset the worker still runs and still
# records attempts, but every attempt is a retryable "not configured" rather
# than a fake success, so the Enquiries screen tells the truth either way.
#
# How often the worker looks for due notifications, in seconds (default 30).
# NOTIFICATION_POLL_SECONDS=30
#
# How many notifications one pass claims (default 20). Claims use
# `for update skip locked`, so more than one API process is safe.
# NOTIFICATION_BATCH_SIZE=20

# ---------- Stripe invoice payment (Final Handover Phase 3) ----------
# Paying an issued invoice online is an OPTION beside account terms, never a
# precondition for ordering. With all of this unset the API boots normally,
# B2B ordering is unaffected, and every payment action reports that online
# payment is switched off — no broken page and no false success.
#
# STRIPE_ENABLED=false (or unset) is the current state of every deployment.
# Setting it true makes the rest of this block REQUIRED: a half-configured
# integration throws at startup rather than running partially live.
# STRIPE_ENABLED=false
#
# Test-mode keys start sk_test_ / pk_test_; live keys start sk_live_ / pk_live_.
# The mode is derived from the prefix, a mismatched pair is refused, and a live
# key OUTSIDE production is refused outright — a staging box copied from
# production configuration is how a real card gets charged during a test.
# STRIPE_SECRET_KEY=sk_test_replace-me
#
# The signing secret for the webhook endpoint (whsec_…), from the Stripe
# dashboard's webhook configuration. REQUIRED whenever Stripe is enabled:
# without it a webhook cannot be verified, and an unverified webhook is an
# unauthenticated way to tell Veyora an invoice was paid.
# STRIPE_WEBHOOK_SECRET=whsec_replace-me
#
# Only needed if a page ever mounts Stripe.js. The hosted-Checkout flow
# redirects the customer to Stripe, so this is normally left unset. It is
# validated if present — a key that is set and wrong is worse than one absent.
# STRIPE_PUBLISHABLE_KEY=
#
# Where Stripe returns the customer. Both are REQUIRED when Stripe is enabled.
# The success page proves only that a browser followed a redirect: it reads the
# invoice's real state and says "confirming" until a signed webhook settles it.
# STRIPE_SUCCESS_URL=https://portal.example.test/#/account?payment=complete
# STRIPE_CANCEL_URL=https://portal.example.test/#/account?payment=cancelled
#
# The webhook endpoint to register in the Stripe dashboard is:
#   https://<portal host>/api/webhooks/stripe
# It is mounted BEFORE the JSON body parser, because a Stripe signature is
# computed over the exact bytes sent and a re-serialised body never verifies.

# ---------- document identity: invoices and statements (Final Handover Phase 5) ----------
# EVERY legal and business fact a generated document prints comes from here.
# Nothing is invented: an unset value is OMITTED from the document rather than
# printed as a placeholder, because an invoice carrying a made-up company
# number would look exactly as authoritative as a real one.
#
# The admin panel reports every REQUIRED field that is still unset, so the
# handover checklist is generated from the code rather than kept by hand.
#
# ---- identity (required before a production invoice is sent) ----
# VEYORA_LEGAL_NAME=
# VEYORA_TRADING_NAME=
# VEYORA_COMPANY_NUMBER=
# VEYORA_TAX_NUMBER=
#
# ---- registered address (required) ----
# VEYORA_ADDRESS_LINE1=
# VEYORA_ADDRESS_LINE2=
# VEYORA_ADDRESS_CITY=
# VEYORA_ADDRESS_REGION=
# VEYORA_ADDRESS_POSTCODE=
# VEYORA_ADDRESS_COUNTRY=
#
# ---- billing contact (email required) ----
# VEYORA_CONTACT_EMAIL=
# VEYORA_CONTACT_PHONE=
# VEYORA_WEBSITE_URL=
#
# ---- offline payment instructions (optional as a block) ----
# Omitted entirely when unset. An invoice with no bank block is a normal
# invoice; one with HALF a bank block is not, so these are all-or-nothing.
# VEYORA_BANK_NAME=
# VEYORA_BANK_ACCOUNT_NAME=
# VEYORA_BANK_IBAN=
# VEYORA_BANK_SWIFT=
#
# ---- footer (optional) ----
# Retention of title, late-payment terms, and any other legal wording. This is
# the client's to supply; no default legal text is shipped.
# VEYORA_INVOICE_FOOTER=
#
# ---- logo (optional) ----
# An absolute path on the server to a PNG or JPEG. A missing, unreadable or
# unsupported file falls back to the VEYORA wordmark — a decorative asset must
# never be able to stop a customer downloading their invoice.
# VEYORA_INVOICE_LOGO=/opt/veyora/assets/invoice-logo.png

# ---------- Zoho Inventory (see docs/RUNBOOK.md for how to obtain these) ----------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=875980504
ZOHO_DC=com
ZOHO_SYNC_MINUTES=30

# ---------- "Scan your list" OCR (optional; feature is dormant without it) ----------
ANTHROPIC_API_KEY=
SCAN_MODEL=claude-haiku-4-5-20251001

# ---------- public website (Fast-Track Workstream 2) ----------
# Required by the `web` container. It refuses to start without them
# (scripts/validate-env.mjs), which is deliberate: a wrong canonical origin
# breaks both SEO and form CSRF, and failing loudly is better than serving a
# site that looks fine and cannot accept an enquiry.
#
# PUBLIC_SITE_ORIGIN must be the exact public origin browsers use, including
# scheme. It drives canonical URLs, robots.txt, the sitemap, and Astro's
# security.allowedDomains — which is what makes form POSTs pass the CSRF
# origin check behind Caddy.
PUBLIC_SITE_ORIGIN=https://example.test
# Where the B2B portal lives once it moves off the public host.
PORTAL_ORIGIN=https://portal.example.test

# ---------- release-candidate routing (Caddyfile.rc only) ----------
# Host names for the two-site topology. Unset, the current single-host
# Caddyfile stays in effect and these are ignored.
PUBLIC_DOMAIN=example.test
PORTAL_DOMAIN=portal.example.test

# Selects which Caddy topology is mounted. UNSET = the current, live
# single-host Caddyfile. Set to ./Caddyfile.rc to cut over to the public
# website taking the catch-all. Removing the line rolls back.
# CADDYFILE=./Caddyfile.rc
